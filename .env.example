# Copy to .env (local) or pass with `docker run --env-file .env .`. Every setting the app reads is here; the image bakes in none of them except the HOST/PORT defaults.
DATABASE_URL=sqlite:////data/roomready.db
INSPECTION_REQUIRED_FOR=Standard,Deluxe,Suite
STALL_AFTER_MINUTES=60
SEED_DIR=seed
HOST=0.0.0.0
PORT=8080
